  "data": {
    "body": "Deterministic serialization means the same logical object always produces byte-for-byte identical output. In CONCH, this is achieved by using BTreeMap for all key-value fields (keys sort alphabetically) and declaring struct fields in canonical section order (meta, schema, data, permissions, history).",
    "confidence": 9,
    "source": "CONCH Platform — Milestone 2",
    "tags": ["serialization", "determinism", "conch", "rust"],
    "title": "Deterministic Serialization in CONCH"
  },
